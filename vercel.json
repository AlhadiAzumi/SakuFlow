{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/terms/", "destination": "/terms/index.html" },
    { "source": "/promo", "destination": "/index.html" },
    { "source": "/promo/", "destination": "/index.html" },
    { "source": "/masuk", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/catatan", "destination": "/index.html" },
    { "source": "/setelan", "destination": "/index.html" },
    { "source": "/setelan/:page", "destination": "/index.html" }
  ]
}

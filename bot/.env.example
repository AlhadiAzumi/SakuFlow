# --- Server ---
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Bisa lebih dari satu, dipisah koma. Pakai * kalau diakses dari IP jaringan/HP:
# WEB_ORIGIN=http://localhost:5173,http://192.168.1.10:5173

# --- Meta WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=ganti-dengan-token-verifikasi-anda
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# --- Supabase (pakai SERVICE ROLE, jangan pernah dipakai di browser!) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# true = tidak kirim WA & tidak tulis Supabase, cukup log ke terminal (untuk uji lokal)
BOT_DRY_RUN=true

# Opsional: kode OTP tetap untuk uji lokal
BOT_DRY_OTP_CODE=123456

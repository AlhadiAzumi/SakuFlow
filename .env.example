# Isi dua baris ini kalau sudah punya project Supabase.
# Kalau dikosongkan, aplikasi otomatis pakai mode lokal (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL server bot WhatsApp (kosongkan jika belum menjalankan bot)
VITE_BOT_API_URL=http://localhost:3001

# Site key Cloudflare Turnstile (opsional, sudah ada nilai bawaan di kode).
# Secret key tidak ditaruh di sini, tapi di Supabase → Authentication → Attack Protection.
VITE_TURNSTILE_SITE_KEY=
